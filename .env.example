# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: nunca use o prefixo NEXT_PUBLIC_ e nunca faça commit do valor real.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos links de recuperação de senha). Ex.: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=

# Segredo aleatório (>= 32 caracteres) para assinar cookies do fluxo de agendamento.
# Gere com: openssl rand -base64 48
BOOKING_COOKIE_SECRET=

# Somente para testes de integração com um Postgres local (NÃO aponte para produção).
# TEST_DATABASE_URL=
